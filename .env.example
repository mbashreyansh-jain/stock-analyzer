# Copy this file to .env and fill in your own values. Never share .env: it holds passwords and keys.

# PostgreSQL. Local Windows install: user stockai, the password you chose, port 5432.
# (The old Docker setup on the Mac used port 5433.)
DATABASE_URL=postgresql://stockai:CHANGE-ME@localhost:5432/stockai

# Where downloaded NSE files are cached (relative to repo root)
STOCKAI_RAW_DIR=data/raw

# Seconds to wait between NSE requests
STOCKAI_NSE_MIN_INTERVAL=0.4

# The address people use to open the website. Invite links are built from it.
STOCKAI_PUBLIC_URL=http://localhost:8000

# true only when the site is served over HTTPS (the cloud server). Must be false on http://localhost.
STOCKAI_COOKIE_SECURE=false

# How long a sign-in lasts before asking again
STOCKAI_SESSION_DAYS=30

# Google Gemini, for "Rewrite with AI" on the Blog page. Leave empty to use the free templates only.
# Get a key at https://aistudio.google.com. If you see "no model called ...", pick a current Flash model there.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
